{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": { "includeFiles": "data/catalog.json", "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/", "destination": "/media/", "permanent": false },
    { "source": "/media", "destination": "/media/", "permanent": true },
    { "source": "/media/admin", "destination": "/media/admin/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/media/api/catalog", "destination": "/api/catalog" },
    { "source": "/media/api/admin", "destination": "/api/admin" },
    { "source": "/media/", "destination": "/media/index.html" },
    { "source": "/media/admin/", "destination": "/media/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/media/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/media/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    }
  ]
}
