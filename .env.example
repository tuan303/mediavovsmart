# Server-side only. Never commit real values or paste tokens into chat.
# Primary production backend: Private Vercel Blob.
# Vercel injects this token when the private store is connected to the project.
# Catalog object path: media/catalog.json
BLOB_READ_WRITE_TOKEN=
# Alternative Blob authentication: connected store ID + automatic Vercel OIDC.
# BLOB_STORE_ID=

# Separate admin access key, generated with: npm run admin:key
MEDIA_ADMIN_KEY=
MEDIA_ALLOWED_ORIGINS=https://vovsmart.net,https://www.vovsmart.net,https://mediavovsmart.vercel.app

# Optional alternative backend: GitHub Contents API.
# Leave these unset when using Blob. Blob is selected if BLOB_READ_WRITE_TOKEN
# or BLOB_STORE_ID is set. Do not copy production storage to Preview.
# GITHUB_REPOSITORY=tuan303/mediavovsmart
# GITHUB_BRANCH=main
# GITHUB_TOKEN=
